void main(void) {
    int x;
    
    // Erro 1: faltando ';' na atribuicao
    x = 10
    
    // Se o panic mode funcionar, ele vai se recuperar neste proximo ';' e continuar!
    x = 20;
    
    // Erro 2: IF faltando '('
    if x == 20) {
        x = x + 1;
    }
    
    // Erro 3: Expressão matemática com operadores seguidos
    x = x + * 2;
    
    // Erro 4: Falta o ')' no while
    while (x > 0 {
        x = x - 1;
    }
}
